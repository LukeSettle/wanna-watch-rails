<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#14101f">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="google-adsense-account" content="ca-pub-2455305491841820">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9MM8NTLTNP"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-9MM8NTLTNP');
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2455305491841820"
     crossorigin="anonymous"></script>
  <script>
    window.WW_ADS = {
      client: "ca-pub-2455305491841820",
      // Optional: paste Display ad unit IDs from AdSense → Ads → By ad unit
      slots: {
        home: "<%= ENV.fetch('ADSENSE_SLOT_HOME', '') %>",
        results: "<%= ENV.fetch('ADSENSE_SLOT_RESULTS', '') %>"
      }
    };
  </script>
  <title>WannaWatch — Swipe movies with friends</title>
  <meta name="description" content="Tinder-style movie matching. Swipe through the same list as your friends and find a movie you all wanna watch.">
  <link rel="icon" href="/logo.png">
  <meta property="og:title" content="WannaWatch">
  <meta property="og:description" content="Swipe movies with friends and find one you all wanna watch.">
  <meta property="og:image" content="/logo.png">
  <link rel="stylesheet" href="/web/app.css?v=17">
</head>
<body>
  <div id="app">
    <div class="screen center">
      <img src="/logo.png" alt="WannaWatch" class="logo pulse">
      <p class="muted">Loading…</p>
    </div>
  </div>
  <div id="toast" class="toast" hidden></div>
  <div id="invite-popup" class="invite-popup" hidden>
    <div class="invite-popup-card">
      <p class="invite-popup-text">You have a game invite</p>
      <div class="invite-popup-actions">
        <button class="btn btn-primary" id="invite-accept">Accept</button>
        <button class="btn btn-ghost" id="invite-decline">Decline</button>
      </div>
    </div>
  </div>

  <footer class="doc-footer">
    <p>WannaWatch is a free web app for swiping movies with friends until you match on something everyone wants to watch.</p>
    <nav aria-label="About WannaWatch">
      <a href="/how-it-works">How it works</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
    </nav>
  </footer>

  <noscript>
    <main class="doc-noscript">
      <h1>WannaWatch</h1>
      <p>Swipe the same movie list as your friends and match on a title you all like. JavaScript is required to play.</p>
      <p><a href="/how-it-works">How it works</a> · <a href="/about">About</a> · <a href="/contact">Contact</a> · <a href="/privacy">Privacy</a></p>
    </main>
  </noscript>

  <script src="/web/api.js?v=17"></script>
  <script src="/web/cable.js?v=17"></script>
  <script src="/web/shop.js?v=17"></script>
  <script src="/web/app.js?v=17"></script>
</body>
</html>
