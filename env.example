# Copy to .env for local development (gitignored). Use Stripe test-mode keys.
# Restricted key (rk_test_...) is preferred over a secret key (sk_test_...).
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/stripe/webhook` (local only).
# Production uses a different secret from the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
